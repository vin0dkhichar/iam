BACKEND_API_URL=http://iam-agent.openg2p.my
# Web sign-in (Keycloak client agent-portal). Mobile uses agent-app instead.
LOGIN_PROVIDER_ID=agent-portal
APPLICATION_MNEMONIC=agent-portal
# Same masterdata URL as iam-staff-ui (required for ATTRIBUTE/GEO filter fields).
MASTERDATA_API_URL=http://masterdata-api.openg2p.my
# Registry URL is NOT hardcoded — it comes from the agency application's api_url (same as staff-ui).
COOKIE_DOMAIN=.openg2p.my
